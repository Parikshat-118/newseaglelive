# =====================================================
# News Eagle Live — PRODUCTION CONFIG (pre-filled)
# =====================================================

# --- Telegram ---
BOT_TOKEN=:
BOT_USERNAME=NewsEagleLiveBot

# --- MySQL ---
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=eagle:

# --- AI / OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PRIMARY_MODEL=x-ai/grok-4.3
AI_FALLBACK_MODEL=x-ai/grok-4
AI_REQUEST_TIMEOUT=45
AI_MAX_TOKENS=1024
OPENROUTER_SITE_URL=https://newseagle.live
OPENROUTER_APP_NAME=News Eagle Live

# --- News Sources ---
NEWSAPI_KEY=replace-or-leave-blank
GNEWS_API_KEY=replace-or-leave-blank
RSS_EXTRA_FEEDS=

# --- Weather ---
WEATHER_API_KEY=

# --- Admin (Telegram user IDs for /admin command) ---
ADMIN_IDS=

# --- Scheduler ---
SCHEDULER_TIMEZONE=Asia/Kolkata
NEWS_FETCH_INTERVAL_MIN=5
SUMMARY_INTERVAL_MIN=10
ALERT_INTERVAL_MIN=15
MORNING_DIGEST_HOUR=7
EVENING_DIGEST_HOUR=19
SCHEDULER_STANDALONE=false

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# --- Misc ---
DEFAULT_LANGUAGE=en
APP_ENV=production
